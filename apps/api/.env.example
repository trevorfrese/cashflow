# Copy to .env for local development. Never commit .env.

NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# Postgres. docker compose exposes the container on POSTGRES_PORT (root .env), default 5432.
DATABASE_URL=postgresql://cashflow:cashflow@localhost:5432/cashflow
# Used by integration tests. The docker init script creates this database.
DATABASE_URL_TEST=postgresql://cashflow:cashflow@localhost:5432/cashflow_test

# Auth. Generate a real secret for anything beyond local dev: openssl rand -base64 48
JWT_SECRET=dev-only-change-me-please-use-openssl-rand
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Comma separated list of allowed browser origins, or * for any.
CORS_ORIGIN=*

# Providers. "mock" is the only one that runs out of the box and never moves money.
# plaid, square, and stripe are compile-only skeletons that refuse to start without keys.
# cashflow is the in-house cash flow engine (src/underwriting). mock is an alias.
UNDERWRITING_PROVIDER=cashflow
BANK_LINK_PROVIDER=mock
COMMERCE_PROVIDER=mock
PAYMENTS_PROVIDER=mock
CAPITAL_PROVIDER=mock
# Identity verification and sanctions screening. mock is the only implementation: it
# verifies and clears everything except names carrying a sandbox keyword (see README.md).
IDENTITY_PROVIDER=mock

# Scheduled jobs inside the API process. Set JOBS_ENABLED=false and use `pnpm job:run` from cron instead if you prefer.
JOBS_ENABLED=true
JOBS_CRON=0 * * * *

# Operator routes under /v1/admin: review queue, alerts, lease changes, screening hits, the
# ledger, running jobs, funding the mock capital pool. Every request needs one of the two
# bearer tokens below and an X-Admin-Actor header naming the person acting.
# The API refuses to start with ENABLE_ADMIN=true and no ADMIN_API_TOKEN.
ENABLE_ADMIN=true
# PLACEHOLDERS, NOT SECRETS. They only make a local copy of this file start. Replace both
# before the API is reachable by anyone else: openssl rand -hex 32
# At least 32 characters each, and the two must differ.
# admin: everything. reviewer: the queues and read-only views of the book.
ADMIN_API_TOKEN=local-dev-admin-token-replace-me-0000000000
REVIEWER_API_TOKEN=local-dev-reviewer-token-replace-me-00000

# Dev tools under /v1/dev: sign in as a persona without a password, move the simulated
# clock, rebuild the demo data. The routes are not registered unless this is true, and the
# API refuses to start with it on when NODE_ENV=production. `./dev` writes true into the
# local .env it generates. Leave it false anywhere else.
ENABLE_DEV_TOOLS=false

# Rate limiting, per client address. Auth routes (register, login, refresh) have their own,
# lower limit. Set RATE_LIMIT_ENABLED=false to turn it off.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_WINDOW_SECONDS=60
# An account is locked for LOGIN_LOCKOUT_MINUTES after this many wrong passwords in a row.
# 0 turns lockout off.
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# Only read when the matching provider is selected.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
STRIPE_SECRET_KEY=
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
SQUARE_ENV=sandbox
