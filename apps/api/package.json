{
  "name": "@cashflow/api",
  "version": "0.1.0",
  "private": true,
  "description": "CashFlow API. Fastify, Prisma, Postgres, Zod. Mock money providers by default.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx src/index.ts",
    "build": "prisma generate && tsc --noEmit",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "prisma generate && vitest run",
    "test:unit": "prisma generate && vitest run --project unit",
    "test:int": "prisma generate && vitest run --project integration",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "job:run": "tsx --env-file-if-exists=.env src/jobs/cli.ts"
  },
  "dependencies": {
    "@cashflow/shared": "workspace:*",
    "@fastify/cors": "^11.4.1",
    "@fastify/jwt": "^10.2.7",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.3",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "node-cron": "^4.6.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "prisma": "^7.10.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
