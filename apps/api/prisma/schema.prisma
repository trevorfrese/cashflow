// CashFlow data model. Money is integer cents. Calendar dates (due dates, periods) are
// YYYY-MM-DD strings so they compare correctly without timezone math. Timestamps are DateTime.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// ---------- Auth ----------

model User {
  id                String         @id @default(cuid())
  email             String         @unique
  passwordHash      String
  fullName          String
  /// Failed sign ins since the last success or lockout. See `src/auth/lockout.ts`.
  failedLoginCount  Int            @default(0)
  lastFailedLoginAt DateTime?
  /// Sign in is refused until this time after too many failures in a row.
  lockedUntil       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  businesses        Business[]
  refreshTokens     RefreshToken[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ---------- Business ----------

enum BusinessStatus {
  ONBOARDING
  ACTIVE
  SUSPENDED
}

enum Industry {
  RESTAURANT
  RETAIL
  SALON
  FITNESS
  PROFESSIONAL_SERVICES
  HEALTHCARE
  OTHER
}

/// Where identity verification of a business or an owner stands. UNVERIFIED is a row that
/// has not been through the identity provider yet (it predates the check, or is missing a
/// tax id or owners).
enum VerificationStatus {
  UNVERIFIED
  VERIFIED
  REVIEW
  FAILED
}

/// Result of screening a name against sanctions and watchlists.
enum ScreeningOutcome {
  CLEAR
  POSSIBLE_MATCH
  MATCH
}

enum ScreeningPartyType {
  BUSINESS
  OWNER
  /// The landlord on a lease, as the payee of a payout.
  LANDLORD
}

model Business {
  id                        String             @id @default(cuid())
  ownerUserId               String
  owner                     User               @relation(fields: [ownerUserId], references: [id])
  legalName                 String
  dba                       String?
  industry                  Industry
  addressLine1              String
  addressLine2              String?
  city                      String
  state                     String
  postalCode                String
  foundedOn                 String // YYYY-MM-DD
  statedMonthlyRevenueCents Int
  status                    BusinessStatus     @default(ONBOARDING)
  /// Last four digits of the tax id. The full number is never stored. Null on rows that
  /// predate identity verification.
  taxIdLast4                String?
  verificationStatus        VerificationStatus @default(UNVERIFIED)
  verificationCheckedAt     DateTime?
  verificationProvider      String?
  /// Opaque reference to the check at the identity provider.
  verificationRef           String?
  /// Provider reason codes behind a REVIEW or FAILED status. Internal.
  verificationReasons       String[]           @default([])
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  owners        BeneficialOwner[]
  screenings    ScreeningResult[]
  bankLinks     BankLink[]
  commerceLinks CommerceLink[]
  applications  UnderwritingApplication[]
  leases        Lease[]
  rentPlans     RentPlan[]

  @@index([ownerUserId])
}

/// A person who owns or controls the business. Name, title and ownership only: no date of
/// birth and no government id number is ever stored. `verificationRef` points at the
/// record the identity provider holds.
model BeneficialOwner {
  id                 String             @id @default(cuid())
  businessId         String
  business           Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  fullName           String
  title              String
  /// Ownership in basis points: 2500 is 25%.
  ownershipBps       Int
  verificationStatus VerificationStatus @default(UNVERIFIED)
  verificationRef    String?
  verifiedAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([businessId])
}

/// One screening of one party against sanctions and watchlists. A history: every screening
/// adds a row and sets `supersededAt` on the one before it for the same party. The current
/// result for a party is the row with `supersededAt` null. A hit (POSSIBLE_MATCH or MATCH)
/// is open until a reviewer clears it.
model ScreeningResult {
  id            String             @id @default(cuid())
  businessId    String
  business      Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  partyType     ScreeningPartyType
  /// Business id, beneficial owner id, or lease id, by party type.
  partyRef      String
  nameScreened  String
  country       String?
  result        ScreeningOutcome
  provider      String
  /// The provider's reference for the match, or for the search when it was clear.
  providerRef   String?
  /// Set when the name screened is the proposed landlord on a pending lease change.
  leaseChangeId String?
  screenedAt    DateTime           @default(now())
  supersededAt  DateTime?
  /// Manual clearance of a hit: who, when, and why.
  clearedBy     String?
  clearedAt     DateTime?
  clearedReason String?

  @@index([partyType, partyRef, supersededAt])
  @@index([businessId])
  @@index([result, clearedAt])
}

// ---------- Bank link ----------

enum BankLinkStatus {
  PENDING
  LINKED
  ERROR
  DISCONNECTED
}

/// How a connection's data is obtained. See `apps/api/DATA_CONNECTIONS.md`. There is no upload
/// method: CashFlow pulls the data itself or does not use it.
enum ConnectionAccessMethod {
  DIRECT_OAUTH
  DELEGATED_SEAT
  AGGREGATOR
}

/// Where a connection stands for pulling data.
enum ConnectionHealth {
  HEALTHY
  PENDING
  REAUTH_REQUIRED
  ERROR
  REVOKED
}

enum ConnectionKind {
  BANK
  COMMERCE
}

enum CommercePlatform {
  SQUARE
  TOAST
  SHOPIFY
  CLOVER
  STRIPE
}

model BankLink {
  id                    String         @id @default(cuid())
  businessId            String
  business              Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  provider              String
  providerItemId        String
  /// Opaque token the PaymentsProvider can charge. Mock accepts anything.
  providerAccountToken  String
  institutionName       String
  accountMask           String
  availableBalanceCents Int?
  status                BankLinkStatus @default(LINKED)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  // Provenance (data veracity phase). Everything below comes from the aggregator, never from
  // the applicant.
  accessMethod          ConnectionAccessMethod @default(AGGREGATOR)
  /// The bank authorized the connection through its own OAuth, rather than a legacy one.
  /// Null when the aggregator did not say.
  institutionAuthorized Boolean?
  /// The aggregator's id for the account within the item.
  platformAccountId     String?
  /// Account holder names as the bank reports them.
  accountOwnerNames     String[]               @default([])
  /// BUSINESS or PERSONAL, as the bank reports it.
  accountType           String?
  /// YYYY-MM-DD the account was opened, where the aggregator provides it.
  accountOpenedOn       String?
  /// Every account visible on the same login: [{ mask, name, type, shared }].
  visibleAccounts       Json?
  /// The aggregator's access token, AES-256-GCM encrypted (`src/crypto/token-vault.ts`).
  /// Never returned by any response, never logged.
  accessTokenEnc        String?
  consentScopes         String[]               @default([])
  consentExpiresAt      DateTime?
  health                ConnectionHealth       @default(HEALTHY)
  lastPulledAt          DateTime?
  lastPullError         String?
  revokedAt             DateTime?

  applications UnderwritingApplication[]

  @@index([businessId])
}

/// A connected point of sale or commerce platform. Read only: it verifies sales at the
/// source for underwriting and is never used to move money.
model CommerceLink {
  id             String           @id @default(cuid())
  businessId     String
  business       Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  provider       String
  platform       CommercePlatform
  providerItemId String
  locationName   String
  status         BankLinkStatus   @default(LINKED)
  /// YYYY-MM-DD the business started selling on the platform.
  connectedSince String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // Provenance (data veracity phase). Identity fields come from the platform, never from the
  // applicant.
  accessMethod       ConnectionAccessMethod @default(DIRECT_OAUTH)
  legalName          String?
  platformAccountId  String?
  country            String?
  /// YYYY-MM-DD the platform account was created.
  accountCreatedOn   String?
  taxIdLast4         String?
  /// Where the platform pays out: [{ institutionName, mask, ref }].
  payoutDestinations Json?
  scopes             String[]               @default([])
  /// Platform-issued tokens, AES-256-GCM encrypted. Never returned, never logged.
  accessTokenEnc     String?
  refreshTokenEnc    String?
  tokenExpiresAt     DateTime?
  /// DELEGATED_SEAT: CashFlow's own service user the merchant invited. Never a merchant login.
  seatServiceUser    String?
  seatVerifiedAt     DateTime?
  health             ConnectionHealth       @default(HEALTHY)
  lastPulledAt       DateTime?
  lastPullError      String?
  revokedAt          DateTime?

  applications UnderwritingApplication[]

  @@index([businessId])
}

/// An OAuth authorization in flight: the state CashFlow sent the owner to the platform with,
/// and the PKCE verifier (encrypted). Consumed once by the callback.
model ConnectionAuthorization {
  id               String           @id @default(cuid())
  state            String           @unique
  businessId       String
  userId           String
  platform         CommercePlatform
  provider         String
  redirectUri      String
  codeVerifierEnc  String
  scopes           String[]
  createdAt        DateTime         @default(now())
  expiresAt        DateTime
  consumedAt       DateTime?
  commerceLinkId   String?

  @@index([businessId])
}

/// One pull of a connection's data, stored as it was normalized. Append only: a database
/// trigger rejects UPDATE and DELETE, and a re-pull adds a row. The ids are plain columns, as
/// on `AuditEvent`, so that deleting a business never has to delete its evidence. The sandbox
/// keeps the payload here; production would keep it in object storage and store the key.
model DataSnapshot {
  id             String         @id @default(cuid())
  kind           ConnectionKind
  businessId     String
  bankLinkId     String?
  commerceLinkId String?
  provider       String
  /// CONNECT, APPLICATION, REFRESH, REUNDERWRITE.
  reason         String
  pulledAt       DateTime
  windowFrom     String
  windowTo       String
  /// sha256 over the canonical serialization of `payload`.
  contentHash    String
  recordCounts   Json
  payloadBytes   Int
  payload        Json
  createdAt      DateTime       @default(now())

  @@index([bankLinkId, pulledAt])
  @@index([commerceLinkId, pulledAt])
  @@index([businessId])
}

// ---------- Underwriting ----------

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  APPROVED
  DECLINED
  NEEDS_INFO
  /// Referred to a reviewer. Terms are not shown until a review is recorded.
  IN_REVIEW
}

enum DecisionOutcome {
  APPROVED
  DECLINED
  NEEDS_INFO
  /// The engine would not decide alone. A reviewer records the outcome.
  REFER
}

/// Why a decision row exists.
enum DecisionKind {
  /// The underwriting engine ran on a submission.
  ENGINE
  /// A reviewer recorded an outcome.
  REVIEW
  /// The monthly re-underwriting job re-scored a business with an active plan.
  PERIODIC_REVIEW
  /// The refresh-eligibility job re-scored a business on a pass-through plan, with its
  /// payment history, to see whether it now qualifies for a financed plan. Never current.
  ELIGIBILITY_REVIEW
  /// The owner accepted a graduation offer: the terms of the eligibility review become the
  /// application's current decision, and a financed plan opens from the next period.
  GRADUATION
}

enum ReviewDecision {
  APPROVE
  DECLINE
  REQUEST_INFO
}

model UnderwritingApplication {
  id                        String            @id @default(cuid())
  businessId                String
  business                  Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bankLinkId                String?
  bankLink                  BankLink?         @relation(fields: [bankLinkId], references: [id])
  commerceLinkId            String?
  commerceLink              CommerceLink?     @relation(fields: [commerceLinkId], references: [id])
  statedMonthlyRevenueCents Int
  timeInBusinessMonths      Int
  requestedMonthlyRentCents Int
  status                    ApplicationStatus @default(DRAFT)
  submittedAt               DateTime?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt

  /// Every decision ever made on the application, newest last. Append only: a new decision
  /// supersedes the previous one, nothing is deleted. Read the current one through
  /// `CURRENT_DECISION` in `src/services/decisions.ts`.
  decisions UnderwritingDecision[]
  reviews   ApplicationReview[]
  rentPlans RentPlan[]

  @@index([businessId])
}

/// One decision on an application. Rows are never deleted or rewritten: a later decision
/// sets `supersededAt` on the one before it. A partial unique index (see the migration)
/// guarantees at most one current origination decision per application.
model UnderwritingDecision {
  id                              String                  @id @default(cuid())
  applicationId                   String
  application                     UnderwritingApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  kind                            DecisionKind            @default(ENGINE)
  /// Version of the credit policy in force, for example "cashflow-v2".
  policyVersion                   String                  @default("cashflow-v1")
  /// Inputs summary, thresholds in force, integrity flags, fee build up with PD and expected
  /// loss, exposure caps, referral triggers. Internal: never serialized to applicants.
  snapshot                        Json?
  /// Set when a later decision replaced this one. Null on the current decision.
  supersededAt                    DateTime?
  /// The review that produced this decision, for kind REVIEW.
  reviewId                        String?
  review                          ApplicationReview?      @relation(fields: [reviewId], references: [id])
  /// A reviewer's outcome or terms differed from the engine's recommendation.
  isOverride                      Boolean                 @default(false)
  /// YYYY-MM the periodic review covers, for kind PERIODIC_REVIEW. One per application per month.
  reviewPeriod                    String?
  outcome                         DecisionOutcome
  approvedMonthlyLimitCents       Int?
  feeBps                          Int?
  /// CashFlow score 0..100 and letter grade. Null when there was not enough data to score.
  score                           Int?
  grade                           String?
  recommendedInstallmentsPerMonth Int?
  /// Array of { code, message, impact }.
  reasons                         Json
  /// The principal reasons the applicant is told on a decline, a counter offer, or a
  /// request for information: at most four { code, title, text, guidance }, most important
  /// first, every code from the reason catalog in packages/shared. Null on decisions stored
  /// before the catalog, and on approvals at the rent requested.
  principalReasons                Json?
  /// CashFlowSummary features the decision was based on. Null without bank data.
  cashFlow                        Json?
  provider                        String
  decidedAt                       DateTime                @default(now())

  @@unique([applicationId, reviewPeriod])
  @@index([applicationId, supersededAt])
}

/// A reviewer's decision on a referred or reconsidered application. Append only.
model ApplicationReview {
  id                        String                  @id @default(cuid())
  applicationId             String
  application               UnderwritingApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  /// Who reviewed: the name in the X-Admin-Actor header of the authenticated request.
  reviewer                  String
  decision                  ReviewDecision
  reasonCodes               String[]
  notes                     String?
  /// Terms the reviewer approved, when they approved.
  approvedMonthlyLimitCents Int?
  feeBps                    Int?
  /// The outcome or terms differ from what the engine recommended.
  isOverride                Boolean                 @default(false)
  /// The decision the reviewer was looking at.
  reviewedDecisionId        String
  createdAt                 DateTime                @default(now())

  decisions UnderwritingDecision[]

  @@index([applicationId])
}

// ---------- Adverse action notices ----------

/// Why a notice was sent. See apps/api/UNDERWRITING.md, "Reasons and adverse action notices".
enum AdverseActionNoticeKind {
  /// The application was declined, by the engine or a reviewer.
  DECLINE
  /// A counter offer was declined by the applicant, or expired without being used.
  COUNTER_OFFER_NOT_ACCEPTED
  /// A notice of incompleteness (12 CFR 1002.9(c)(2)): what is missing, and by when.
  INCOMPLETE
  /// The application stayed incomplete past the date in that notice and was closed.
  INCOMPLETE_DECLINED
}

enum NoticeChannel {
  IN_APP
}

/// A notice sent to an applicant, exactly as rendered. Append only: a database trigger
/// rejects UPDATE and DELETE. Like DataSnapshot it has no foreign keys, so deleting a
/// business never has to delete a notice it was sent: a notice is a record that has to be
/// kept (12 CFR 1002.12(b)). One notice per decision and kind.
model AdverseActionNotice {
  id               String                  @id @default(cuid())
  applicationId    String
  /// The decision the notice is about.
  decisionId       String
  businessId       String
  kind             AdverseActionNoticeKind
  /// At most four { code, title, text, guidance }, as rendered into the notice.
  principalReasons Json
  reasonCodes      String[]
  /// The full notice text, as delivered.
  text             String
  /// Version of the notice template and the statements in it.
  statementVersion String
  /// YYYY-MM-DD the action was taken, or the notice became due.
  actionOn         String
  /// YYYY-MM-DD the notice had to be delivered by.
  deadlineOn       String
  /// YYYY-MM-DD to provide the missing information by, on a notice of incompleteness.
  respondBy        String?
  channel          NoticeChannel           @default(IN_APP)
  deliveredAt      DateTime
  /// "engine", "reviewer:<name>", "applicant", or "job".
  generatedBy      String
  createdAt        DateTime                @default(now())

  @@unique([decisionId, kind])
  @@index([applicationId])
  @@index([businessId])
}

// ---------- Audit ----------

/// Append only record of who did what to which record. A database trigger rejects UPDATE
/// and DELETE on this table.
model AuditEvent {
  id          String   @id @default(cuid())
  at          DateTime @default(now())
  /// "system", "user", "reviewer", or "job".
  actorType   String
  actorId     String?
  /// For example DECISION_MADE, REVIEW_RECORDED, PLAN_CREATED.
  eventType   String
  /// For example "application", "rent_plan".
  subjectType String
  subjectId   String
  payload     Json

  @@index([subjectType, subjectId])
  @@index([eventType, at])
}

// ---------- Monitoring ----------

enum AlertSeverity {
  INFO
  WARNING
  HIGH
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

/// Something a person should look at, raised by a monitoring rule. A partial unique index
/// (see the migration) allows one alert per `dedupeKey` that is not RESOLVED, so a condition
/// that persists does not open a second alert.
model Alert {
  id             String        @id @default(cuid())
  /// The rule that raised it, for example "fraud.payout_change_before_payout".
  type           String
  /// FRAUD, PAYMENTS, PORTFOLIO, BOOKS, COMPLIANCE.
  category       String
  severity       AlertSeverity
  /// For example "rent_plan", "lease", "business", "application", "portfolio", "ledger", "job".
  subjectType    String
  subjectId      String
  title          String
  detail         Json
  status         AlertStatus   @default(OPEN)
  /// CONFIRMED, FALSE_POSITIVE, NO_ACTION, DUPLICATE, or CONDITION_CLEARED when the monitor
  /// resolved it because the condition went away.
  disposition    String?
  dedupeKey      String
  createdAt      DateTime      @default(now())
  /// Last monitor run that still found the condition.
  lastSeenAt     DateTime      @default(now())
  acknowledgedBy String?
  acknowledgedAt DateTime?
  resolvedBy     String?
  resolvedAt     DateTime?
  notes          String?

  @@index([status, severity])
  @@index([type])
  @@index([subjectType, subjectId])
  @@index([dedupeKey])
}

/// A persisted switch a monitoring rule can trip. One row per breaker; today the only one is
/// "new_approvals": while tripped, an application the engine would approve is referred to a
/// reviewer instead. Reset only by an admin.
model CircuitBreaker {
  id             String    @id
  tripped        Boolean   @default(false)
  reason         String?
  trippedAt      DateTime?
  trippedByRule  String?
  trippedAlertId String?
  resetAt        DateTime?
  resetBy        String?
  resetReason    String?
  updatedAt      DateTime  @updatedAt
}

// ---------- Lease ----------

enum LeaseStatus {
  DRAFT
  ACTIVE
  ENDED
}

model Lease {
  id                         String      @id @default(cuid())
  businessId                 String
  business                   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  landlordName               String
  landlordEmail              String
  propertyLine1              String
  propertyLine2              String?
  propertyCity               String
  propertyState              String
  propertyPostalCode         String
  monthlyRentCents           Int
  dueDayOfMonth              Int
  startsOn                   String // YYYY-MM-DD
  endsOn                     String? // YYYY-MM-DD
  landlordAccountHolderName  String
  landlordRoutingNumber      String
  landlordAccountNumberLast4 String
  /// Opaque PaymentsProvider destination token. Mock accepts anything; "mock_fail" forces failures.
  landlordPayoutToken        String
  status                     LeaseStatus @default(ACTIVE)
  createdAt                  DateTime    @default(now())
  updatedAt                  DateTime    @updatedAt

  rentPlans     RentPlan[]
  changes       LeaseChange[]
  disbursements LandlordDisbursement[]

  @@index([businessId])
}

enum LeaseChangeStatus {
  PENDING
  APPLIED
  CANCELLED
  REJECTED
}

/// A requested change to who a lease pays (landlord identity or payout account) on a lease
/// with a running plan. It waits out a cooling-off period, during which payouts on the lease
/// are held, and then applies; the owner can cancel it and a reviewer can approve it early
/// or reject it. A partial unique index (see the migration) allows one PENDING per lease.
model LeaseChange {
  id                String            @id @default(cuid())
  leaseId           String
  lease             Lease             @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  businessId        String
  requestedByUserId String
  status            LeaseChangeStatus @default(PENDING)
  /// The lease columns to set when the change applies.
  changes           Json
  /// What those columns held when the change was requested. The payout token is left out.
  previous          Json
  /// Names of the fields being changed, for display.
  fields            String[]
  requestedAt       DateTime          @default(now())
  /// YYYY-MM-DD the cooling-off period ends and the change applies on its own.
  effectiveOn       String
  appliedAt         DateTime?
  /// A reviewer approved it early or rejected it: who, when, and why.
  decidedBy         String?
  decidedAt         DateTime?
  decisionReason    String?
  cancelledAt       DateTime?

  @@index([leaseId, status])
  @@index([status, effectiveOn])
}

// ---------- Rent plan ----------

enum RentPlanStatus {
  ACTIVE
  PAUSED
  CLOSED
}

/// What a plan does with the landlord's rent. FINANCED: CashFlow pays the landlord from the
/// capital pool on the due date and the business repays in installments plus a fee.
/// PASS_THROUGH: free, for a business declined on credit capacity. CashFlow collects the full
/// rent from the business first and pays the landlord only once that collection has settled.
/// It never advances its own money, never touches the pool or the exposure caps.
enum RentPlanKind {
  FINANCED
  PASS_THROUGH
}

/// One month of a pass-through plan. See `src/services/pass-through.ts`.
enum PassThroughPeriodStatus {
  /// Generated, nothing debited yet.
  SCHEDULED
  /// The debit was accepted and is inside the settlement window: it can still come back.
  COLLECTING
  /// Past the settlement window. Waiting for the due date (or held) to pay the landlord.
  SETTLED
  /// The landlord was paid from the settled collection.
  PAID
  /// Nothing was collected in time, or the collection came back before the landlord was
  /// paid. CashFlow did not pay the landlord; the owner was told to pay directly.
  MISSED
  /// Collected, but the landlord payout could not go out within its window (a hold that did
  /// not clear). The money went back to the business.
  REFUNDED
  /// The collection came back after the landlord had been paid. The business owes CashFlow.
  RETURNED_AFTER_PAYOUT
  /// Closed before any money moved: the plan closed or graduated.
  CANCELLED
}

/// A standing offer to move a pass-through customer onto a financed plan.
enum GraduationOfferStatus {
  /// Made by the refresh-eligibility job. The owner can accept until `expiresOn`.
  OFFERED
  /// Accepted. The financed plan starts once the pass-through period in flight is done.
  ACCEPTED
  /// The financed plan exists and the pass-through plan is closed.
  COMPLETED
  /// Not accepted in time.
  EXPIRED
  /// Taken back before it took effect: a missed month, a closed plan, or a financed plan
  /// that could not open.
  WITHDRAWN
}

enum DisbursementStatus {
  /// Sent to the landlord. At most one per lease and period month (partial unique index).
  SENT
  /// The landlord's bank sent it back. A resend is a new row.
  RETURNED
}

enum PayoutStatus {
  SCHEDULED
  /// Due, but not paid while something holds it. Released or cancelled by the payout job.
  HELD
  PAID
  FAILED
  /// Never paid and never will be. Its installments are VOIDED.
  CANCELLED
}

enum InstallmentStatus {
  SCHEDULED
  PAID
  FAILED
  LATE
  /// Written off. Still owed: a later payment is booked as a recovery.
  CHARGED_OFF
  /// Never owed: the landlord payout was cancelled or came back.
  VOIDED
}

enum RepaymentStatus {
  SUCCEEDED
  FAILED
  /// The debit went through and the bank later sent it back.
  RETURNED
}

/// Where a plan stands, from the age of its oldest unpaid installment. Boundaries live in
/// `src/servicing/policy.ts`.
enum DelinquencyStatus {
  CURRENT
  GRACE
  DELINQUENT
  DEFAULT
  CHARGED_OFF
}

model RentPlan {
  id                   String                  @id @default(cuid())
  /// FINANCED or PASS_THROUGH. Fixed for the life of the plan: a pass-through customer that
  /// graduates gets a new financed plan, and the pass-through plan is closed.
  kind                 RentPlanKind            @default(FINANCED)
  businessId           String
  business             Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  leaseId              String
  lease                Lease                   @relation(fields: [leaseId], references: [id])
  applicationId        String
  application          UnderwritingApplication @relation(fields: [applicationId], references: [id])
  installmentsPerMonth Int                     @default(2)
  feeBps               Int
  monthlyRentCents     Int
  dueDayOfMonth        Int
  status               RentPlanStatus          @default(ACTIVE)
  /// Set by the re-underwriting job when a periodic review falls below the watch threshold,
  /// by an unauthorized return, or by a returned landlord payout. While set, no new rent
  /// period is generated and a payout that falls due is held. Periods already paid out are
  /// still collected. Cleared only by a reviewer.
  advanceFrozenAt      DateTime?
  advanceFrozenReason  String?
  /// The lease's rent went up past what the decision or the exposure rules allow. Payouts
  /// are held (whole rent or nothing) until a new decision covers this amount.
  pendingRentCents     Int?
  pendingRentSince     DateTime?
  /// The delinquency bucket as of the last aging run or payment. Stored because a change of
  /// bucket is an event (it is audited, and provisioning and the ops summary group by it).
  /// Days past due is not stored: it is derived from the oldest unpaid installment on read.
  delinquencyStatus    DelinquencyStatus       @default(CURRENT)
  closedAt             DateTime?
  /// For example CHARGED_OFF.
  closedReason         String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  payouts            LandlordPayout[]
  installments       Installment[]
  passThroughPeriods PassThroughPeriod[]
  graduationOffers   GraduationOffer[]

  @@index([businessId])
  @@index([status])
  @@index([delinquencyStatus])
  @@index([kind, status])
}

/// One month of a pass-through plan: the business's rent collected ahead of the due date,
/// then paid to the landlord once the collection has settled. One row per plan and month.
model PassThroughPeriod {
  id                    String                  @id @default(cuid())
  rentPlanId            String
  rentPlan              RentPlan                @relation(fields: [rentPlanId], references: [id], onDelete: Cascade)
  periodMonth           String // YYYY-MM
  amountCents           Int
  /// YYYY-MM-DD the landlord is due to be paid.
  dueDate               String
  /// YYYY-MM-DD of the first scheduled debit: the policy's lead time before the due date.
  collectOn             String
  /// YYYY-MM-DD of the last day a debit can be made and still settle before the due date.
  lastCollectOn         String
  status                PassThroughPeriodStatus @default(SCHEDULED)
  /// Debits presented so far. A debit put off by the balance check is not an attempt.
  collectionAttempts    Int                     @default(0)
  /// YYYY-MM-DD of the last debit presented, so a second run on the same day does not debit again.
  lastAttemptOn         String?
  /// Why the last scheduled debit was put off (INSUFFICIENT_BALANCE, NO_BANK_LINK), and when.
  collectionSkipReason  String?
  collectionSkippedOn   String?
  collectedOn           String?
  collectionProviderRef String?
  collectionBankLinkId  String?
  /// YYYY-MM-DD the collection is past the return window the policy models.
  settlesOn             String?
  settledOn             String?
  paidOn                String?
  paidAt                DateTime?
  payoutProviderRef     String?
  /// LEASE_CHANGE_PENDING, ADVANCE_FROZEN, PLAN_PAUSED: why a settled payout is waiting.
  heldReason            String?
  heldAt                DateTime?
  /// Why the month was missed: COLLECTION_FAILED, INSUFFICIENT_BALANCE, NO_BANK_LINK,
  /// COLLECTION_RETURNED.
  missedReason          String?
  /// Bank return code on a returned collection, and the date it arrived.
  returnCode            String?
  returnedOn            String?
  refundedOn            String?
  refundProviderRef     String?
  /// PLAN_CLOSED, GRADUATED.
  cancelledReason       String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@unique([rentPlanId, periodMonth])
  @@index([status, dueDate])
  @@index([collectionProviderRef])
}

/// An offer to move a pass-through customer onto a financed plan, made by the
/// refresh-eligibility job from an ELIGIBILITY_REVIEW decision. A partial unique index (see
/// the migration) allows one OFFERED or ACCEPTED offer per pass-through plan.
model GraduationOffer {
  id                        String                @id @default(cuid())
  businessId                String
  passThroughPlanId         String
  passThroughPlan           RentPlan              @relation(fields: [passThroughPlanId], references: [id], onDelete: Cascade)
  applicationId             String
  /// The ELIGIBILITY_REVIEW decision the offer was made on.
  decisionId                String
  status                    GraduationOfferStatus @default(OFFERED)
  approvedMonthlyLimitCents Int
  feeBps                    Int
  installmentsPerMonth      Int
  score                     Int
  grade                     String
  /// On time pass-through months in a row when the offer was made.
  onTimeMonths              Int
  offeredOn                 String // YYYY-MM-DD
  expiresOn                 String // YYYY-MM-DD
  acceptedAt                DateTime?
  acceptedOn                String?
  /// YYYY-MM of the first financed period, set when the financed plan opens.
  effectivePeriod           String?
  financedPlanId            String?
  completedAt               DateTime?
  withdrawnReason           String?
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt

  @@index([businessId, status])
  @@index([status, expiresOn])
}

/// Every payment of rent to a landlord, whichever plan and kind made it. The database
/// allows one SENT row per lease and period month (partial unique index, see the migration),
/// and a row is written before the payments provider is called, inside the same database
/// transaction. So the same month can never be paid to a landlord twice: not by a payout
/// released twice, not by two job runs at once, and not by two plans on one lease.
model LandlordDisbursement {
  id             String             @id @default(cuid())
  leaseId        String
  lease          Lease              @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  periodMonth    String // YYYY-MM
  rentPlanId     String
  kind           RentPlanKind
  /// The LandlordPayout id (FINANCED) or PassThroughPeriod id (PASS_THROUGH).
  sourceId       String
  /// The ledger posting and provider key of this send.
  idempotencyKey String             @unique
  amountCents    Int
  status         DisbursementStatus @default(SENT)
  providerRef    String?
  effectiveDate  String
  createdAt      DateTime           @default(now())
  returnedAt     DateTime?

  @@index([leaseId, periodMonth])
  @@index([sourceId])
}

model LandlordPayout {
  id            String       @id @default(cuid())
  rentPlanId    String
  rentPlan      RentPlan     @relation(fields: [rentPlanId], references: [id], onDelete: Cascade)
  periodMonth   String // YYYY-MM
  amountCents   Int
  scheduledFor  String // YYYY-MM-DD
  status        PayoutStatus @default(SCHEDULED)
  paidAt        DateTime?
  providerRef   String?
  failureReason String?
  /// PAST_DUE, ADVANCE_FROZEN, PLAN_PAUSED, PLAN_CLOSED, NOT_PAID_IN_TIME. Kept on a
  /// cancelled payout as the reason it was never paid. Cleared when a held payout is paid.
  heldReason    String?
  heldAt        DateTime?
  cancelledAt   DateTime?
  /// Bank return code when a paid payout came back, for example R03. Cleared when a
  /// reviewer re-sends the payout to corrected landlord details.
  returnCode    String?
  /// Times a returned payout was sent again. Each send has its own ledger posting key.
  resendCount   Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  installments Installment[]

  @@unique([rentPlanId, periodMonth])
  @@index([status, scheduledFor])
  @@index([providerRef])
}

model Installment {
  id                   String            @id @default(cuid())
  rentPlanId           String
  rentPlan             RentPlan          @relation(fields: [rentPlanId], references: [id], onDelete: Cascade)
  payoutId             String
  payout               LandlordPayout    @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  periodMonth          String // YYYY-MM
  sequence             Int
  principalCents       Int
  feeCents             Int
  totalCents           Int
  dueDate              String // YYYY-MM-DD
  status               InstallmentStatus @default(SCHEDULED)
  paidAt               DateTime?
  /// Set when written off. Stays set when the installment is paid later (a recovery).
  chargedOffAt         DateTime?
  /// Debits presented to `attemptBankLinkId` so far, failed or returned. A debit put off by
  /// the balance check is not an attempt. Starts again from zero on a new bank link.
  attemptCount         Int               @default(0)
  lastAttemptOn        String? // YYYY-MM-DD
  attemptBankLinkId    String?
  /// Why the last scheduled debit was put off (INSUFFICIENT_BALANCE, NO_BANK_LINK), and when.
  collectionSkipReason String?
  collectionSkippedOn  String? // YYYY-MM-DD
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  repayments Repayment[]

  @@unique([payoutId, sequence])
  @@index([status, dueDate])
}

model Repayment {
  id            String          @id @default(cuid())
  installmentId String
  installment   Installment     @relation(fields: [installmentId], references: [id], onDelete: Cascade)
  amountCents   Int
  provider      String
  providerRef   String?
  status        RepaymentStatus
  failureReason String?
  /// The bank link that was debited. Null when there was none to debit.
  bankLinkId    String?
  /// Bank return code on a failed or returned debit, for example R01.
  returnCode    String?
  returnedAt    DateTime?
  /// The owner asked for this payment, as opposed to the collection job.
  manual        Boolean         @default(false)
  /// Booked as a recovery: the installment had been written off.
  recovery      Boolean         @default(false)
  createdAt     DateTime        @default(now())

  @@index([installmentId])
  @@index([providerRef])
}

// ---------- Ledger ----------

enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

model LedgerAccount {
  id        String            @id @default(cuid())
  /// Stable code such as "capital_pool", "cash", "fee_revenue", "allowance:credit_losses",
  /// "receivable:<businessId>".
  code      String            @unique
  name      String
  type      LedgerAccountType
  ownerType String?
  ownerId   String?
  createdAt DateTime          @default(now())

  entries LedgerEntry[]

  @@index([ownerType, ownerId])
}

model LedgerTransaction {
  id             String   @id @default(cuid())
  description    String
  referenceType  String?
  referenceId    String?
  /// Guards against double posting for the same business event.
  idempotencyKey String?  @unique
  /// When the row was written.
  postedAt       DateTime @default(now())
  /// The calendar date the movement belongs to, YYYY-MM-DD. Differs from `postedAt` when
  /// history is replayed with `job:run --as-of`.
  effectiveDate  String

  entries LedgerEntry[]

  @@index([referenceType, referenceId])
  @@index([effectiveDate])
}

model LedgerEntry {
  id            String            @id @default(cuid())
  transactionId String
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  accountId     String
  account       LedgerAccount     @relation(fields: [accountId], references: [id])
  direction     LedgerDirection
  amountCents   Int

  @@index([accountId])
  @@index([transactionId])
}

// ---------- Jobs ----------

model JobRun {
  id         String    @id @default(cuid())
  name       String
  asOf       String // YYYY-MM-DD the job treated as "today"
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean?
  summary    Json?
  error      String?

  @@index([name, startedAt])
}
