# Base URL of the CashFlow API. On a physical device replace localhost with your
# computer's LAN IP address, for example http://192.168.1.20:4000.
# Android emulators reach the host machine at http://10.0.2.2:4000.
EXPO_PUBLIC_API_URL=http://localhost:4000

# The hidden dev menu: personas, the simulated clock, resets. Off unless true. It needs the
# API running with ENABLE_DEV_TOOLS=true. `./dev` writes true into the local .env.
EXPO_PUBLIC_DEV_TOOLS=false
# Where the dev menu's links to the operations console and the dev home page go.
EXPO_PUBLIC_OPS_URL=http://localhost:3200
EXPO_PUBLIC_DEV_HOME_URL=http://localhost:4100
