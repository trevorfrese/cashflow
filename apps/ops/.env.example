# Copy to .env.local for local development. Never commit .env.local.

# Where the CashFlow API is listening. The console only ever talks to this address.
CASHFLOW_API_URL=http://localhost:4000

# Encrypts the session cookie, which holds the operator token. At least 32 characters.
# Generate one with: openssl rand -hex 32
OPS_SESSION_SECRET=replace-with-the-output-of-openssl-rand-hex-32

# Optional. Extra origins allowed to make state-changing requests, comma separated, for
# when the console sits behind a local reverse proxy under another name. Leave empty.
OPS_ALLOWED_ORIGINS=
